# Copy to .env and fill in. Never commit .env.

# Claude (Anthropic) for document extraction and background analysis
LLM_MODE=live
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_FAST_MODEL=claude-haiku-5-5
LLM_DOCUMENT_EFFORT=low
LLM_API_KEY=

# Folder the app watches for new PDF/PNG/JPG files (default: <project>/incoming)
WATCH_INTERVAL_SECONDS=30

# Outgoing email: log (writes data/runtime/outbox.jsonl) or smtp
OUTBOUND_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
