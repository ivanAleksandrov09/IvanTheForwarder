# Copy to .env (never commit .env). Every value has a safe default; the app runs with no .env at all.
# Keep comments on their own lines (inline comments can leak into values).

# ---- app ----
# dev | demo | test
APP_ENV=dev
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
# The (fictional) forwarder using the assistant; appears in drafted messages.
COMPANY_NAME="Спедиция Витоша ЕООД"
COMPANY_NAME_LATIN="Vitosha Forwarding Ltd"
OPERATOR_NAME="Иван Иванов"
OPERATOR_NAME_LATIN="Ivan Ivanov"

# ---- clock ----
# fixed = seed data, detectors and "days overdue" are all relative to DEMO_NOW -> deterministic demo.
# real  = wall clock (seed data will look stale).
CLOCK_MODE=fixed
# If you change DEMO_NOW, re-run `npm run seed`.
DEMO_NOW=2026-10-15T07:30:00Z

# ---- LLM (OpenAI-compatible; switch provider by config only) ----
# mock = canned offline responses, live = real API call
LLM_MODE=mock
# live mode: if the API still fails after retries, return the canned response (demo safety net)
LLM_FALLBACK_TO_MOCK=true
# Gemini (free tier):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
# OpenAI:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
# Ollama (stage 2, fully local):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:7b-instruct
#   LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=4
LLM_TEMPERATURE=0.3
# send response_format=json_object; set false if a provider rejects it
LLM_JSON_MODE=true
# writes data/runtime/logs/llm.jsonl (gitignored)
LLM_LOG_PROMPTS=true

# ---- connectors: "mock" or a real implementation name ----
# email: mock | imap (TODO owner A)
CONNECTOR_EMAIL=mock
CONNECTOR_DOCUMENTS=mock
CONNECTOR_GPS=mock
CONNECTOR_ERP=mock
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# ---- outbound ----
# log  = append to data/runtime/outbox.jsonl
# smtp = sandbox SMTP (use Mailtrap or MailHog, never a real client address)
OUTBOUND_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
