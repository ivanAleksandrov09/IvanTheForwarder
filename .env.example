# Copy to .env and fill in. Never commit .env.

# Claude (Anthropic) for document extraction and background analysis
LLM_MODE=live
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_FAST_MODEL=claude-haiku-5-5
# Model for reading PDFs/images. Empty = LLM_FAST_MODEL, then LLM_MODEL. Try claude-sonnet-5-5 for messy scans.
LLM_DOCUMENT_MODEL=
# Effort is rejected by claude-haiku-4-5; set low/medium/high only with a model that supports it (Sonnet/Opus).
LLM_DOCUMENT_EFFORT=
LLM_API_KEY=

# Folder the app watches for new PDF/PNG/JPG files (default: <project>/incoming)
WATCH_INTERVAL_SECONDS=30

# Outgoing email: log (writes data/runtime/outbox.jsonl) or smtp
OUTBOUND_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Live truck GPS via Traccar (open-source GPS platform; most trackers can report to it). Set CONNECTOR_GPS=traccar and fill in:
#   TRACCAR_URL=https://your-traccar-server        TRACCAR_TOKEN=<API token from Traccar: Account > Token>
#   (or TRACCAR_USER / TRACCAR_PASSWORD)
#   TRACCAR_DEVICE_MAP=12:trk_0003,15:trk_0004       <- Traccar device id : Ivan truck id, comma separated
# Positions are pulled every minute; a status-update draft per in-transit shipment is queued every STATUS_UPDATE_HOURS (0 = off).
STATUS_UPDATE_HOURS=4
