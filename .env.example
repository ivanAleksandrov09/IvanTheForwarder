# Copy to .env and fill in. Never commit .env.

# Claude (Anthropic) for document extraction and background analysis
LLM_MODE=live
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_FAST_MODEL=claude-haiku-5-5
LLM_EFFORT=low
# Model for reading PDFs/images. Empty = LLM_FAST_MODEL, then LLM_MODEL. Try claude-sonnet-5-5 for messy scans.
LLM_DOCUMENT_MODEL=
# Effort is rejected by claude-haiku-4-5; set low/medium/high only with a model that supports it (Sonnet/Opus).
LLM_DOCUMENT_EFFORT=
LLM_API_KEY=

# Folder the app watches for new PDF/PNG/JPG files (default: <project>/incoming)
WATCH_INTERVAL_SECONDS=30

# Outgoing email: log (writes data/runtime/outbox.jsonl) or smtp
OUTBOUND_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Phone-call MP3 extraction: mock stores a safe placeholder transcript.
STT_MODE=mock

# Live truck GPS via Traccar (open-source GPS platform; most trackers can report to it). Set CONNECTOR_GPS=traccar and fill in:
#   TRACCAR_URL=https://your-traccar-server        TRACCAR_TOKEN=<API token from Traccar: Account > Token>
#   (or TRACCAR_USER / TRACCAR_PASSWORD)
#   TRACCAR_DEVICE_MAP=12:trk_0003,15:trk_0004       <- Traccar device id : Ivan truck id, comma separated
# ERP (Zeron V/4): CONNECTOR_ERP=zeron_mock uses the sample data in data/mock/zeron.json (no network).
# CONNECTOR_ERP=zeron needs the vendor's web-service details: ZERON_URL=https://... and ZERON_TOKEN=...
# Positions are pulled every minute; a status-update draft per in-transit shipment is queued every STATUS_UPDATE_HOURS (0 = off).
STATUS_UPDATE_HOURS=4

# --- Central index (see docker-compose.yml). Start: docker compose up -d central-db ; then: npm run dev:central  (page: http://localhost:8100)
# Central service side:
#   CENTRAL_DATABASE_URL=postgresql://central:central@localhost:5434/central
#   CENTRAL_INGEST_TOKEN=<a long random secret>        # empty = publishing is disabled
# Company app side (only used when the company opts in on the "Share profile" panel; empty NETWORK_URL = write a local file):
#   NETWORK_URL=http://localhost:8100
#   NETWORK_TOKEN=<the same secret>
